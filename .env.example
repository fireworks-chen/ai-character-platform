# Shared server environment at the repository root. Never copy this to a Vite directory.
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql://postgres:replace-with-a-random-database-password@localhost:5432/ai_character
DATA_ENCRYPTION_KEY=replace-with-a-long-random-encryption-secret
PORT=3000
ADMIN_API_PORT=3100
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
ADMIN_CORS_ORIGINS=http://localhost:4174,http://127.0.0.1:4174

# Real server-side SillyTavern Core, protected with Basic Auth and CSRF.
AI_ENGINE=sillytavern
SILLYTAVERN_URL=http://127.0.0.1:8000
SILLYTAVERN_USERNAME=core
SILLYTAVERN_PASSWORD=replace-with-a-random-core-password

# Optional on first startup. Without a supplied password, local startup creates a
# random password in .data/admin-credentials.txt. Production requires an explicit one.
BOOTSTRAP_ADMIN_EMAIL=admin@local.host
# BOOTSTRAP_ADMIN_PASSWORD=

# Providers, API keys, model rates, packages and payment adapters are configured
# through the authenticated administration UI and saved in PostgreSQL.
# There are no demo users, seeded characters, mock replies or fixed balances.
